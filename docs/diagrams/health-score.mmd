graph TD
    Start["Start: Score = 100"] --> Parse["Parse Sentry.init() config<br/>(regex-based, per-language)"]

    Parse --> Analyze["Analyze each option against<br/>Config Dictionary"]

    Analyze --> Warn{"Warnings Found?"}

    Warn -->|"Error severity<br/>(missing DSN, invalid DSN)"| ErrDeduct["-15 per error"]
    Warn -->|"Warning severity<br/>(debug=true, 100% sample rate)"| WarnDeduct["-5 per warning"]

    Analyze --> Missing["Check missing required options"]
    Missing --> MissReq{"Missing required?"}
    MissReq -->|"dsn missing"| ErrDeduct

    Analyze --> Recs["Generate Recommendations"]
    Recs --> HighRec{"High priority missing?<br/>environment, release"}
    HighRec --> HighDeduct["-10 per high rec"]

    Recs --> MedRec{"Medium priority missing?<br/>tracesSampleRate, beforeSend"}
    MedRec --> MedDeduct["-5 per medium rec"]

    ErrDeduct --> Bonus
    WarnDeduct --> Bonus
    HighDeduct --> Bonus
    MedDeduct --> Bonus

    Bonus["Bonus Points"]
    Bonus -->|"Has environment"| B1["+5"]
    Bonus -->|"Has release"| B2["+5"]
    Bonus -->|"Has beforeSend"| B3["+5"]

    B1 --> Clamp["Clamp to 0-100"]
    B2 --> Clamp
    B3 --> Clamp

    Clamp --> Result{"Final Score"}

    Result -->|">= 90"| Green["GREEN<br/>Excellent configuration"]
    Result -->|">= 70"| Yellow["YELLOW<br/>Good, improvements recommended"]
    Result -->|"< 70"| Red["RED<br/>Needs improvement"]

